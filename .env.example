# Set server-side values in EdgeOne environment variables; never use a VITE_ prefix.
# For offline development, copy this file to .env.local and fill in your own values.
SALTUM_ADMIN_USERNAME=
SALTUM_ADMIN_PASSWORD=
SALTUM_ADMIN_NAME=管理员
SALTUM_BLOB_STORE=saltum-data
SALTUM_SESSION_HOURS=12
# Exact public origin, e.g. https://your-domain.example. Leave empty for same-origin detection.
SALTUM_APP_ORIGIN=
# Reserved public OSS/CDN origin; image storage/upload is intentionally not implemented.
VITE_OSS_BASE_URL=
